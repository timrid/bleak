
import sys
if sys.version_info >= (3, 8):
    from typing import Protocol
else:
    from typing_extensions import Protocol

import android.graphics
import android.os
import java.util
import jpype
import typing



class DisplayHash(android.os.Parcelable):
    CREATOR: typing.ClassVar[android.os.Parcelable.Creator] = ...
    def describeContents(self) -> int: ...
    def toString(self) -> str: ...
    def writeToParcel(self, parcel: android.os.Parcel, int: int) -> None: ...

class DisplayHashManager:
    def getSupportedHashAlgorithms(self) -> java.util.Set[str]: ...
    def verifyDisplayHash(self, displayHash: DisplayHash) -> 'VerifiedDisplayHash': ...

class DisplayHashResultCallback:
    DISPLAY_HASH_ERROR_INVALID_BOUNDS: typing.ClassVar[int] = ...
    DISPLAY_HASH_ERROR_INVALID_HASH_ALGORITHM: typing.ClassVar[int] = ...
    DISPLAY_HASH_ERROR_MISSING_WINDOW: typing.ClassVar[int] = ...
    DISPLAY_HASH_ERROR_NOT_VISIBLE_ON_SCREEN: typing.ClassVar[int] = ...
    DISPLAY_HASH_ERROR_TOO_MANY_REQUESTS: typing.ClassVar[int] = ...
    DISPLAY_HASH_ERROR_UNKNOWN: typing.ClassVar[int] = ...
    def onDisplayHashError(self, int: int) -> None: ...
    def onDisplayHashResult(self, displayHash: DisplayHash) -> None: ...

class VerifiedDisplayHash(android.os.Parcelable):
    CREATOR: typing.ClassVar[android.os.Parcelable.Creator] = ...
    def __init__(self, long: int, rect: android.graphics.Rect, string: str, byteArray: typing.Union[typing.List[int], jpype.JArray, bytes]): ...
    def describeContents(self) -> int: ...
    def getBoundsInWindow(self) -> android.graphics.Rect: ...
    def getHashAlgorithm(self) -> str: ...
    def getImageHash(self) -> typing.MutableSequence[int]: ...
    def getTimeMillis(self) -> int: ...
    def toString(self) -> str: ...
    def writeToParcel(self, parcel: android.os.Parcel, int: int) -> None: ...


class __module_protocol__(Protocol):
    # A module protocol which reflects the result of ``jp.JPackage("android.view.displayhash")``.

    DisplayHash: typing.Type[DisplayHash]
    DisplayHashManager: typing.Type[DisplayHashManager]
    DisplayHashResultCallback: typing.Type[DisplayHashResultCallback]
    VerifiedDisplayHash: typing.Type[VerifiedDisplayHash]
