
import sys
if sys.version_info >= (3, 8):
    from typing import Protocol
else:
    from typing_extensions import Protocol

import android.net
import java.io
import java.lang
import jpype
import typing



class IkeException(java.lang.Exception): ...

class IkeTimeoutException(java.io.IOException):
    def __init__(self, string: str): ...

class IkeNonProtocolException(IkeException): ...

class IkeProtocolException(IkeException):
    ERROR_TYPE_AUTHENTICATION_FAILED: typing.ClassVar[int] = ...
    ERROR_TYPE_CHILD_SA_NOT_FOUND: typing.ClassVar[int] = ...
    ERROR_TYPE_FAILED_CP_REQUIRED: typing.ClassVar[int] = ...
    ERROR_TYPE_INTERNAL_ADDRESS_FAILURE: typing.ClassVar[int] = ...
    ERROR_TYPE_INVALID_IKE_SPI: typing.ClassVar[int] = ...
    ERROR_TYPE_INVALID_KE_PAYLOAD: typing.ClassVar[int] = ...
    ERROR_TYPE_INVALID_MAJOR_VERSION: typing.ClassVar[int] = ...
    ERROR_TYPE_INVALID_MESSAGE_ID: typing.ClassVar[int] = ...
    ERROR_TYPE_INVALID_SELECTORS: typing.ClassVar[int] = ...
    ERROR_TYPE_INVALID_SYNTAX: typing.ClassVar[int] = ...
    ERROR_TYPE_NO_ADDITIONAL_SAS: typing.ClassVar[int] = ...
    ERROR_TYPE_NO_PROPOSAL_CHOSEN: typing.ClassVar[int] = ...
    ERROR_TYPE_SINGLE_PAIR_REQUIRED: typing.ClassVar[int] = ...
    ERROR_TYPE_TEMPORARY_FAILURE: typing.ClassVar[int] = ...
    ERROR_TYPE_TS_UNACCEPTABLE: typing.ClassVar[int] = ...
    ERROR_TYPE_UNSUPPORTED_CRITICAL_PAYLOAD: typing.ClassVar[int] = ...
    def getErrorType(self) -> int: ...

class IkeIOException(IkeNonProtocolException):
    def __init__(self, iOException: java.io.IOException): ...
    def getCause(self) -> java.io.IOException: ...
    def initCause(self, throwable: java.lang.Throwable) -> java.lang.Throwable: ...

class IkeInternalException(IkeNonProtocolException):
    @typing.overload
    def __init__(self, string: str, throwable: java.lang.Throwable): ...
    @typing.overload
    def __init__(self, throwable: java.lang.Throwable): ...

class IkeNetworkLostException(IkeNonProtocolException):
    def __init__(self, network: android.net.Network): ...
    def getNetwork(self) -> android.net.Network: ...

class InvalidKeException(IkeProtocolException):
    def __init__(self, int: int): ...
    def getDhGroup(self) -> int: ...

class InvalidMajorVersionException(IkeProtocolException):
    def __init__(self, byte: int): ...
    def getMajorVersion(self) -> int: ...

class InvalidSelectorsException(IkeProtocolException):
    def __init__(self, int: int, byteArray: typing.Union[typing.List[int], jpype.JArray, bytes]): ...
    def getIpSecPacketInfo(self) -> typing.MutableSequence[int]: ...
    def getIpSecSpi(self) -> int: ...


class __module_protocol__(Protocol):
    # A module protocol which reflects the result of ``jp.JPackage("android.net.ipsec.ike.exceptions")``.

    IkeException: typing.Type[IkeException]
    IkeIOException: typing.Type[IkeIOException]
    IkeInternalException: typing.Type[IkeInternalException]
    IkeNetworkLostException: typing.Type[IkeNetworkLostException]
    IkeNonProtocolException: typing.Type[IkeNonProtocolException]
    IkeProtocolException: typing.Type[IkeProtocolException]
    IkeTimeoutException: typing.Type[IkeTimeoutException]
    InvalidKeException: typing.Type[InvalidKeException]
    InvalidMajorVersionException: typing.Type[InvalidMajorVersionException]
    InvalidSelectorsException: typing.Type[InvalidSelectorsException]
