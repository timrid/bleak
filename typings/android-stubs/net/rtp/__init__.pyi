    def __init__(self, context: android.content.Context): ...
    def clear(self) -> None: ...
    def getMode(self) -> int: ...
    def getStreams(self) -> typing.MutableSequence['AudioStream']: ...
    def sendDtmf(self, int: int) -> None: ...
    def setMode(self, int: int) -> None: ...

class RtpStream:
    MODE_NORMAL: typing.ClassVar[int] = ...
    MODE_RECEIVE_ONLY: typing.ClassVar[int] = ...
    MODE_SEND_ONLY: typing.ClassVar[int] = ...
    def associate(self, inetAddress: java.net.InetAddress, int: int) -> None: ...
    def getLocalAddress(self) -> java.net.InetAddress: ...
    def getLocalPort(self) -> int: ...
    def getMode(self) -> int: ...
