    def getRemotePort(self) -> int: ...
    def isBusy(self) -> bool: ...
    def release(self) -> None: ...
    def setMode(self, int: int) -> None: ...

class AudioStream(RtpStream):
    def __init__(self, inetAddress: java.net.InetAddress): ...
    def getCodec(self) -> AudioCodec: ...
    def getDtmfType(self) -> int: ...
    def getGroup(self) -> AudioGroup: ...
