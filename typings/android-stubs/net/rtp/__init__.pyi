    def getCodec(int: int, string: str, string2: str) -> 'AudioCodec': ...
    @staticmethod
    def getCodecs() -> typing.MutableSequence['AudioCodec']: ...

class AudioGroup:
    MODE_ECHO_SUPPRESSION: typing.ClassVar[int] = ...
    MODE_MUTED: typing.ClassVar[int] = ...
    MODE_NORMAL: typing.ClassVar[int] = ...
    MODE_ON_HOLD: typing.ClassVar[int] = ...
